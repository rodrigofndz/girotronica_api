{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --config ../firebase.test.json --only auth,firestore --project girotronica-api \"vitest run\"",
    "test:watch": "firebase emulators:exec --config ../firebase.test.json --only auth,firestore --project girotronica-api \"vitest\""
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "hono": "^4.13.7",
    "nodemailer": "^10.0.13",
    "qrcode": "^1.5.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/har-format": "^1.2.16",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
